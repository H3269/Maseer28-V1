{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maseer28.example/schemas/knowledge-catalog.v1.schema.json",
  "title": "Maseer28 Assistant Knowledge Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "status", "items"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "catalog_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "status": { "enum": ["empty_pending_external_review", "active"] },
    "items": {
      "type": "array",
      "items": { "$ref": "./approved-knowledge-item.v1.schema.json" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "empty_pending_external_review" } }, "required": ["status"] },
      "then": { "properties": { "items": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "status": { "const": "active" } }, "required": ["status"] },
      "then": { "properties": { "items": { "minItems": 1 } } }
    }
  ]
}
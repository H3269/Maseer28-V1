{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maseer28.invalid/schemas/course-content-mapping.v1.schema.json",
  "title": "Maseer28 Course Content Mapping Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mapping_set_id",
    "status",
    "runtime_eligible",
    "source",
    "mappings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "mapping_set_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft_review_queue_only",
        "under_review",
        "reviewed_not_runtime_approved"
      ]
    },
    "runtime_eligible": {
      "const": false
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_registry",
        "topic_registry",
        "subtopic_registry"
      ],
      "properties": {
        "content_registry": {
          "type": "string"
        },
        "topic_registry": {
          "type": "string"
        },
        "subtopic_registry": {
          "type": "string"
        }
      }
    },
    "policy": {
      "type": "string"
    },
    "mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mapping"
      }
    }
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_id",
        "source_topic_id",
        "source_topic_name",
        "day_number",
        "content_id",
        "subtopic_ids",
        "mapping_status",
        "review"
      ],
      "properties": {
        "mapping_id": {
          "type": "string",
          "pattern": "^MAP_T[0-9]{2}_D[0-9]{2}$"
        },
        "source_topic_id": {
          "type": "string",
          "pattern": "^T[0-9]{2}$"
        },
        "source_topic_name": {
          "type": "string",
          "minLength": 1
        },
        "day_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 28
        },
        "content_id": {
          "type": "string",
          "minLength": 1
        },
        "subtopic_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{2}-S[0-9]{2}$"
          }
        },
        "mapping_status": {
          "enum": [
            "pending_review",
            "in_review",
            "approved",
            "rejected"
          ]
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewer_id",
            "reviewed_at",
            "rationale",
            "evidence_ids"
          ],
          "properties": {
            "reviewer_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "rationale": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^EVD_[A-Z0-9_-]+$"
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

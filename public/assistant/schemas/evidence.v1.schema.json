{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maseer28.example/schemas/evidence.v1.schema.json",
  "title": "Maseer28 Evidence Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "title",
          "url"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "access_date": {
            "type": "string",
            "format": "date"
          },
          "publisher": {
            "type": "string",
            "maxLength": 200
          },
          "publication_date": {
            "type": "string",
            "maxLength": 80
          }
        }
      }
    }
  }
}

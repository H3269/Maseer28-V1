{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maseer28 Course Content Quality Review Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_id",
    "status",
    "runtime_eligible",
    "review_dimensions",
    "reviews"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "ledger_id": {
      "const": "maseer28-course-content-quality-review-v1"
    },
    "status": {
      "enum": [
        "draft_review_queue_only",
        "under_review",
        "reviewed_not_runtime_approved"
      ]
    },
    "runtime_eligible": {
      "const": false
    },
    "review_dimensions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "target_specificity",
          "psychological_mechanism",
          "evidence_support",
          "exercise_alignment",
          "progression_and_difficulty",
          "safety_and_cautions",
          "outcome_measurement",
          "accessibility"
        ]
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    }
  },
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "topic_id",
        "day_number",
        "content_id",
        "review_status",
        "scores",
        "reviewer_id",
        "reviewed_at",
        "rationale",
        "evidence_ids",
        "safety_notes"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "pattern": "^QREV_T[0-9]{2}_D[0-9]{2}$"
        },
        "topic_id": {
          "type": "string",
          "pattern": "^T[0-9]{2}$"
        },
        "day_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 28
        },
        "content_id": {
          "type": "string",
          "minLength": 1
        },
        "review_status": {
          "enum": [
            "pending_review",
            "in_review",
            "needs_revision",
            "rejected",
            "reviewed_not_approved",
            "approved_for_educational_review"
          ]
        },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_specificity",
            "psychological_mechanism",
            "evidence_support",
            "exercise_alignment",
            "progression_and_difficulty",
            "safety_and_cautions",
            "outcome_measurement",
            "accessibility"
          ],
          "properties": {
            "target_specificity": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 3
            },
            "psychological_mechanism": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 3
            },
            "evidence_support": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 3
            },
            "exercise_alignment": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 3
            },
            "progression_and_difficulty": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 3
            },
            "safety_and_cautions": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 3
            },
            "outcome_measurement": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 3
            },
            "accessibility": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 3
            }
          }
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EVD_[A-Z0-9_-]+$"
          }
        },
        "safety_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

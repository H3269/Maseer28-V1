diff --git a/scripts/audit-content-mappings.mjs b/scripts/audit-content-mappings.mjs
@@ -0,0 +1,108 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const readJson = (relativePath) => JSON.parse(fs.readFileSync(path.join(root, relativePath), 'utf8'));
+const normalize = (value) => String(value ?? '').normalize('NFKC').replace(/\s+/g, ' ').trim();
+
+export function auditContentMappings({ content, topics, subtopics, evidenceRegistry, mappingSet }) {
+  const errors = [];
+  const topicByName = new Map((topics.topics ?? []).map((item) => [normalize(item.name), item]));
+  const subtopicById = new Map((subtopics.subtopics ?? []).map((item) => [item.subtopic_id, item]));
+  const evidenceById = new Map((evidenceRegistry?.evidence ?? []).map((item) => [item.evidence_id, item]));
+  const expected = new Map();
+
+  for (const [topicName, category] of Object.entries(content.categories ?? {})) {
+    const topic = topicByName.get(normalize(topicName));
+    if (!topic) {
+      errors.push(`No exact topic match for content category: ${topicName}`);
+      continue;
+    }
+    for (const [index, day] of (category.days ?? []).entries()) {
+      const mappingId = `MAP_${topic.topic_id}_D${String(index + 1).padStart(2, '0')}`;
+      expected.set(mappingId, { topic, topicName, dayNumber: index + 1, contentId: day.id });
+    }
+  }
+
+  const seen = new Set();
+  const counts = { pending_review: 0, in_review: 0, approved: 0, rejected: 0 };
+  for (const mapping of mappingSet.mappings ?? []) {
+    const expectedRecord = expected.get(mapping.mapping_id);
+    if (seen.has(mapping.mapping_id)) errors.push(`Duplicate mapping id: ${mapping.mapping_id}`);
+    seen.add(mapping.mapping_id);
+    if (!expectedRecord) {
+      errors.push(`Unknown mapping id: ${mapping.mapping_id}`);
+      continue;
+    }
+    if (mapping.source_topic_id !== expectedRecord.topic.topic_id ||
+        mapping.source_topic_name !== expectedRecord.topicName ||
+        Number(mapping.day_number) !== expectedRecord.dayNumber ||
+        mapping.content_id !== expectedRecord.contentId) {
+      errors.push(`Source identity mismatch: ${mapping.mapping_id}`);
+    }
+    if (!Object.hasOwn(counts, mapping.mapping_status)) {
+      errors.push(`Invalid mapping status: ${mapping.mapping_id}`);
+      continue;
+    }
+    counts[mapping.mapping_status] += 1;
+
+    for (const subtopicId of mapping.subtopic_ids ?? []) {
+      const subtopic = subtopicById.get(subtopicId);
+      if (!subtopic) errors.push(`Unknown subtopic ${subtopicId}: ${mapping.mapping_id}`);
+      else if (subtopic.topic_id !== mapping.source_topic_id) {
+        errors.push(`Subtopic belongs to another parent topic: ${mapping.mapping_id} -> ${subtopicId}`);
+      }
+    }
+
+    if (mapping.mapping_status === 'approved') {
+      const review = mapping.review ?? {};
+      if (!(mapping.subtopic_ids ?? []).length) errors.push(`Approved mapping has no subtopic: ${mapping.mapping_id}`);
+      if (!String(review.reviewer_id ?? '').trim()) errors.push(`Approved mapping lacks reviewer: ${mapping.mapping_id}`);
+      if (!review.reviewed_at || Number.isNaN(Date.parse(review.reviewed_at))) errors.push(`Approved mapping lacks valid review date: ${mapping.mapping_id}`);
+      if (!String(review.rationale ?? '').trim()) errors.push(`Approved mapping lacks rationale: ${mapping.mapping_id}`);
+      if (!(review.evidence_ids ?? []).length) errors.push(`Approved mapping lacks evidence IDs: ${mapping.mapping_id}`);
+      for (const evidenceId of review.evidence_ids ?? []) {
+        const evidence = evidenceById.get(evidenceId);
+        if (!evidence) errors.push(`Approved mapping references unknown evidence ${evidenceId}: ${mapping.mapping_id}`);
+        else if (evidence.review_status !== 'approved' || !evidence.reviewer_id || !evidence.reviewed_at) {
+          errors.push(`Approved mapping references unapproved evidence ${evidenceId}: ${mapping.mapping_id}`);
+        }
+      }
+    }
+  }
+
+  const missing = [...expected.keys()].filter((id) => !seen.has(id));
+  if (mappingSet.runtime_eligible !== false) errors.push('Mapping set must remain runtime_eligible=false.');
+  if (evidenceRegistry?.runtime_eligible !== false) errors.push('Evidence registry must remain runtime_eligible=false.');
+  return {
+    errors,
+    counts: {
+      expected_source_days: expected.size,
+      mapping_records: seen.size,
+      missing_records: missing.length,
+      ...counts,
+      approved_evidence_records: [...evidenceById.values()].filter((item) => item.review_status === 'approved').length,
+    },
+    readiness: {
+      structural_integrity: errors.length === 0,
+      complete_source_coverage: missing.length === 0,
+      all_records_reviewed: missing.length === 0 && counts.pending_review === 0 && counts.in_review === 0,
+      evidence_registry_ready: evidenceById.size > 0 && [...evidenceById.values()].every((item) => item.review_status === 'approved'),
+      approved_for_runtime: false,
+    },
+    missing_mapping_ids: missing,
+  };
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const report = auditContentMappings({
+    content: readJson('public/content/path-content.json'),
+    topics: readJson('public/assistant/knowledge/topics.v1.json'),
+    subtopics: readJson('public/assistant/knowledge/subtopics.v1.json'),
+    evidenceRegistry: readJson('public/assistant/evidence/evidence.v1.json'),
+    mappingSet: readJson('public/assistant/mappings/course-content-mappings.v1.json'),
+  });
+  process.stdout.write(`${JSON.stringify(report, null, 2)}\n`);
+  if (report.errors.length) process.exitCode = 1;
+}
diff --git a/scripts/generate-content-mapping-queue.mjs b/scripts/generate-content-mapping-queue.mjs
@@ -0,0 +1,67 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const readJson = (relativePath) => JSON.parse(fs.readFileSync(path.join(root, relativePath), 'utf8'));
+const normalize = (value) => String(value ?? '').normalize('NFKC').replace(/\s+/g, ' ').trim();
+
+export function buildContentMappingQueue({ content, topics, existing = null }) {
+  const topicByName = new Map((topics.topics ?? []).map((topic) => [normalize(topic.name), topic]));
+  const oldMappings = new Map((existing?.mappings ?? []).map((item) => [item.mapping_id, item]));
+  const mappings = [];
+
+  for (const [topicName, category] of Object.entries(content.categories ?? {})) {
+    const topic = topicByName.get(normalize(topicName));
+    if (!topic) throw new Error(`No exact topic registry match for content category: ${topicName}`);
+    if (!Array.isArray(category.days) || category.days.length !== 28) {
+      throw new Error(`Expected exactly 28 days for category: ${topicName}`);
+    }
+
+    category.days.forEach((day, index) => {
+      const dayNumber = index + 1;
+      const mappingId = `MAP_${topic.topic_id}_D${String(dayNumber).padStart(2, '0')}`;
+      if (!day.id) throw new Error(`Missing content day id: ${mappingId}`);
+      const previous = oldMappings.get(mappingId);
+      if (previous && previous.content_id !== day.id) {
+        throw new Error(`Source content changed for ${mappingId}; manual reconciliation required.`);
+      }
+      mappings.push(previous ?? {
+        mapping_id: mappingId,
+        source_topic_id: topic.topic_id,
+        source_topic_name: topicName,
+        day_number: dayNumber,
+        content_id: day.id,
+        subtopic_ids: [],
+        mapping_status: 'pending_review',
+        review: { reviewer_id: null, reviewed_at: null, rationale: null, evidence_ids: [] },
+        notes: [],
+      });
+    });
+  }
+
+  if (oldMappings.size > mappings.length) throw new Error('Existing mapping ledger contains records not present in the current course registry.');
+  return {
+    schema_version: '1.0.0',
+    mapping_set_id: 'maseer28-course-content-mappings-v1',
+    status: 'draft_review_queue_only',
+    runtime_eligible: false,
+    source: {
+      content_registry: 'public/content/path-content.json',
+      topic_registry: 'public/assistant/knowledge/topics.v1.json',
+      subtopic_registry: 'public/assistant/knowledge/subtopics.v1.json',
+    },
+    policy: 'Parent topic is assigned only by exact category-name match. Subtopic assignments require human review.',
+    mappings,
+  };
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const outputPath = path.join(root, 'public/assistant/mappings/course-content-mappings.v1.json');
+  const content = readJson('public/content/path-content.json');
+  const topics = readJson('public/assistant/knowledge/topics.v1.json');
+  const existing = fs.existsSync(outputPath) ? readJson('public/assistant/mappings/course-content-mappings.v1.json') : null;
+  const queue = buildContentMappingQueue({ content, topics, existing });
+  fs.writeFileSync(outputPath, `${JSON.stringify(queue, null, 2)}\n`);
+  process.stdout.write(`Generated ${queue.mappings.length} review records; subtopic assignments remain empty and runtime_eligible=false.\n`);
+}
diff --git a/tests/contentMappingWorkflow.test.js b/tests/contentMappingWorkflow.test.js
@@ -0,0 +1,79 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { buildContentMappingQueue } from '../scripts/generate-content-mapping-queue.mjs';
+import { auditContentMappings } from '../scripts/audit-content-mappings.mjs';
+
+const read = async (relative) => JSON.parse(await readFile(new URL(relative, import.meta.url), 'utf8'));
+const [content, topics, subtopics] = await Promise.all([
+  read('../public/content/path-content.json'),
+  read('../public/assistant/knowledge/topics.v1.json'),
+  read('../public/assistant/knowledge/subtopics.v1.json'),
+]);
+const emptyEvidence = { runtime_eligible: false, evidence: [] };
+const approvedEvidence = {
+  runtime_eligible: false,
+  evidence: [{
+    evidence_id: 'EVD_TEST_01',
+    review_status: 'approved',
+    reviewer_id: 'expert-1',
+    reviewed_at: '2026-11-01T12:00:00Z',
+  }],
+};
+
+test('queue creates one pending record per course day without guessing subtopics', () => {
+  const queue = buildContentMappingQueue({ content, topics });
+  assert.equal(queue.mappings.length, 952);
+  assert.equal(queue.runtime_eligible, false);
+  assert.ok(queue.mappings.every((item) => item.mapping_status === 'pending_review'));
+  assert.ok(queue.mappings.every((item) => item.subtopic_ids.length === 0));
+});
+
+test('queue preserves existing human review and refuses silent source replacement', () => {
+  const initial = buildContentMappingQueue({ content, topics });
+  const first = initial.mappings[0];
+  first.mapping_status = 'in_review';
+  first.review.rationale = 'بازبینی در حال انجام';
+  const preserved = buildContentMappingQueue({ content, topics, existing: initial });
+  assert.equal(preserved.mappings[0].mapping_status, 'in_review');
+  assert.equal(preserved.mappings[0].review.rationale, 'بازبینی در حال انجام');
+  const changed = structuredClone(content);
+  const category = Object.values(changed.categories)[0];
+  category.days[0].id = 'changed-source-id';
+  assert.throws(() => buildContentMappingQueue({ content: changed, topics, existing: initial }), /manual reconciliation/);
+});
+
+test('empty review ledger reports coverage gaps without inventing approvals', () => {
+  const queue = buildContentMappingQueue({ content, topics });
+  const report = auditContentMappings({ content, topics, subtopics, evidenceRegistry: emptyEvidence, mappingSet: { ...queue, mappings: [] } });
+  assert.deepEqual(report.errors, []);
+  assert.equal(report.counts.expected_source_days, 952);
+  assert.equal(report.counts.missing_records, 952);
+  assert.equal(report.readiness.complete_source_coverage, false);
+  assert.equal(report.readiness.approved_for_runtime, false);
+});
+
+test('approved mappings require same-parent subtopic, reviewer metadata and approved evidence', () => {
+  const queue = buildContentMappingQueue({ content, topics });
+  const first = queue.mappings[0];
+  const validSubtopic = subtopics.subtopics.find((item) => item.topic_id === first.source_topic_id);
+  first.subtopic_ids = [validSubtopic.subtopic_id];
+  first.mapping_status = 'approved';
+  first.review = {
+    reviewer_id: 'reviewer-1',
+    reviewed_at: '2026-11-01T12:00:00Z',
+    rationale: 'ارتباط محتوای روز با زیرموضوع با بررسی متن کامل تأیید شد.',
+    evidence_ids: ['EVD_TEST_01'],
+  };
+  const report = auditContentMappings({ content, topics, subtopics, evidenceRegistry: approvedEvidence, mappingSet: queue });
+  assert.ok(report.errors.length === 0, report.errors.join('\n'));
+
+  const unapprovedEvidence = structuredClone(approvedEvidence);
+  unapprovedEvidence.evidence[0].review_status = 'pending_review';
+  const invalidEvidence = auditContentMappings({ content, topics, subtopics, evidenceRegistry: unapprovedEvidence, mappingSet: queue });
+  assert.ok(invalidEvidence.errors.some((item) => item.includes('unapproved evidence')));
+
+  first.subtopic_ids = [subtopics.subtopics.find((item) => item.topic_id !== first.source_topic_id).subtopic_id];
+  const invalidSubtopic = auditContentMappings({ content, topics, subtopics, evidenceRegistry: approvedEvidence, mappingSet: queue });
+  assert.ok(invalidSubtopic.errors.some((item) => item.includes('another parent topic')));
+});
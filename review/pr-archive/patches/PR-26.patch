+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { formatAssistantPrompt } from '../src/features/assistant/assistantPreferences.js';
+
+const question = { prompt: 'یک موقعیت مشخص را تعریف می‌کنی؟', stage: 'differential_clarification' };
+
+test('supportive, direct, detail, and example preferences change non-safety prompts', () => {
+  const supportive = formatAssistantPrompt(question, { communication_style: 'supportive', response_detail: 'detailed', example_style: 'practical' });
+  assert.match(supportive, /با آرامش/);
+  assert.match(supportive, /نمونه واقعی/);
+  assert.match(supportive, /لازم نیست حدس بزنی/);
+  const balanced = formatAssistantPrompt(question, { response_detail: 'balanced' });
+  assert.match(balanced, /نمونه کوتاه/);
+  const concise = formatAssistantPrompt(question, { response_detail: 'concise' });
+  assert.doesNotMatch(concise, /نمونه کوتاه/);
+  const direct = formatAssistantPrompt(question, { communication_style: 'direct', example_style: 'conceptual' });
+  assert.match(direct, /پاسخ کوتاه/);
+  assert.match(direct, /الگوی کلی/);
+});
+
+test('safety prompts are never altered by personalization preferences', () => {
+  const safety = { prompt: 'آیا همین الآن در خطر هستی؟', stage: 'safety_check' };
+  assert.equal(formatAssistantPrompt(safety, { communication_style: 'supportive', response_detail: 'detailed', example_style: 'conceptual' }), safety.prompt);
+});
+
+test('missing question returns an empty prompt', () => {
+  assert.equal(formatAssistantPrompt(null, {}), '');
+});
diff --git a/tests/consentManager.test.js b/tests/consentManager.test.js
@@ -0,0 +1,73 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { CONSENT_STORAGE_KEY, getConsentState, hasConsent, grantConsent, withdrawConsent, clearConsentState } from '../src/features/privacy/consentManager.js';
+
+function memoryStorage() {
+  const values = new Map();
+  return {
+    getItem: (key) => values.has(key) ? values.get(key) : null,
+    setItem: (key, value) => values.set(key, String(value)),
+    removeItem: (key) => values.delete(key),
+  };
+}
+const cloud = { processor_identity:'Provider A', processing_region:'EU', data_categories:'prompt text only', retention_period:'30 days', withdrawal_method:'in-app control' };
+const sensitive = { necessity_explanation:'Explicit user-requested processing only', exact_data_categories:'user-provided wellbeing text' };
+const memory = { retention_period:'30 days', view_edit_delete_controls:'available in app' };
+const analytics = { purpose_limitation:'aggregate feature usage', avoid_sensitive_content:true };
+
+test('all consent purposes default to false and no implicit consent is inferred', () => {
+  const storage=memoryStorage();
+  const state=getConsentState(storage);
+  for (const item of Object.values(state.purposes)) assert.equal(item.granted,false);
+  assert.equal(hasConsent('ai_cloud_processing',storage),false);
+});
+
+test('grant requires explicit action and complete purpose-specific context', () => {
+  const storage=memoryStorage();
+  assert.throws(()=>grantConsent('ai_cloud_processing',{explicitAction:false,context:cloud},storage),/اقدام صریح/);
+  assert.throws(()=>grantConsent('ai_cloud_processing',{explicitAction:true,context:{processor_identity:'Provider A'}},storage),/کامل نیست/);
+  assert.equal(hasConsent('ai_cloud_processing',storage),false);
+});
+
+test('health-data consent is separate and requires cloud consent first', () => {
+  const storage=memoryStorage();
+  assert.throws(()=>grantConsent('sensitive_health_data_processing',{explicitAction:true,context:sensitive},storage),/رضایت جداگانه/);
+  grantConsent('ai_cloud_processing',{explicitAction:true,context:cloud},storage);
+  grantConsent('sensitive_health_data_processing',{explicitAction:true,context:sensitive},storage);
+  assert.equal(hasConsent('ai_cloud_processing',storage),true);
+  assert.equal(hasConsent('sensitive_health_data_processing',storage),true);
+});
+
+test('withdrawing cloud consent also withdraws sensitive processing consent', () => {
+  const storage=memoryStorage();
+  grantConsent('ai_cloud_processing',{explicitAction:true,context:cloud},storage);
+  grantConsent('sensitive_health_data_processing',{explicitAction:true,context:sensitive},storage);
+  const state=withdrawConsent('ai_cloud_processing',{},storage);
+  assert.equal(state.purposes.ai_cloud_processing.granted,false);
+  assert.equal(state.purposes.sensitive_health_data_processing.granted,false);
+  assert.ok(state.purposes.ai_cloud_processing.withdrawn_at);
+});
+
+test('memory and analytics consent remain independent from cloud and health consent', () => {
+  const storage=memoryStorage();
+  grantConsent('long_term_ai_memory',{explicitAction:true,context:memory},storage);
+  grantConsent('product_analytics',{explicitAction:true,context:analytics},storage);
+  assert.equal(hasConsent('long_term_ai_memory',storage),true);
+  assert.equal(hasConsent('product_analytics',storage),true);
+  assert.equal(hasConsent('ai_cloud_processing',storage),false);
+});
+
+test('clearing consent returns every purpose to false', () => {
+  const storage=memoryStorage();
+  grantConsent('long_term_ai_memory',{explicitAction:true,context:memory},storage);
+  clearConsentState(storage);
+  assert.equal(storage.getItem(CONSENT_STORAGE_KEY),null);
+  assert.equal(hasConsent('long_term_ai_memory',storage),false);
+});
+
+test('unknown purposes are rejected and never treated as consented', () => {
+  const storage=memoryStorage();
+  assert.equal(hasConsent('unknown_purpose',storage),false);
+  assert.throws(()=>grantConsent('unknown_purpose',{explicitAction:true,context:{}},storage),/شناخته‌شده/);
+  assert.throws(()=>withdrawConsent('unknown_purpose',{},storage),/شناخته‌شده/);
+});
diff --git a/tests/contentRedesignValidation.test.js b/tests/contentRedesignValidation.test.js
@@ -0,0 +1,26 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { validateContentRedesign } from '../scripts/validate-content-redesign.mjs';
+
+function makeData(){
+ const topics=Array.from({length:34},(_,i)=>({topic_id:'T'+String(i+1).padStart(2,'0')}));
+ const subtopics=topics.flatMap(x=>[1,2,3].map(n=>({subtopic_id:x.topic_id+'-S0'+n,topic_id:x.topic_id})));
+ const records=topics.flatMap(topic=>Array.from({length:28},(_,i)=>{
+  const day=i+1, id='QREV_'+topic.topic_id+'_D'+String(day).padStart(2,'0');
+  return {review_id:id,topic_id:topic.topic_id,day_number:day,source_content_id:topic.topic_id+'-'+String(day).padStart(2,'0'),draft_content_id:day<=3?'DRAFT_'+topic.topic_id+'_D0'+day:null,redesign_status:day<=3?'draft_created_pending_review':'not_started',review_status:'pending_review',runtime_eligible:false,scores:{dimension:null}};
+ }));
+ const buildDrafts=day=>topics.map(topic=>({content_id:'DRAFT_'+topic.topic_id+'_D0'+day,source_content_id:topic.topic_id+'-0'+day,topic_id:topic.topic_id,subtopic_id:topic.topic_id+'-S0'+day,day_number:day,learning_objective:'هدف مشخص '+topic.topic_id,mechanism_focus:'سازوکار محدود',exercise:'تمرین مشاهده '+topic.topic_id,action:'اقدام کم‌خطر '+topic.topic_id,progress_measure:'سنجه مشاهده‌پذیر '+topic.topic_id,safety_and_limits:'حدود ایمنی',evidence_ids:[],review_status:'draft_pending_expert_review',runtime_eligible:false}));
+ return {queue:{records},day1:{records:buildDrafts(1)},day2:{records:buildDrafts(2)},day3:{records:buildDrafts(3)},topics:{topics},subtopics:{subtopics}};
+}
+test('validates full 952 queue and first three 34-topic draft batches',()=>{
+ const result=validateContentRedesign(makeData());
+ assert.equal(result.valid,true,result.errors.join('; '));
+});
+test('blocks premature activation and unverified evidence claims',()=>{
+ const data=makeData();
+ data.day3.records[0].runtime_eligible=true;
+ data.day3.records[0].evidence_ids=['EVD_FAKE'];
+ const result=validateContentRedesign(data);
+ assert.ok(result.errors.some(x=>x.includes('draft not blocked')));
+ assert.ok(result.errors.some(x=>x.includes('unverified evidence claimed')));
+});

+        : 'رضایت لغو شد و ترجیحات ذخیره‌شده برای حذف محلی ارسال شدند.');
+    } catch (cause) {
+      setError(cause?.message || 'لغو رضایت انجام نشد.');
+    }
+  }
+
+  return <section className="sectionHint" aria-labelledby="personalization-settings-title">

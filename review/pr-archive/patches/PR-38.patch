diff --git a/scripts/validate-independent-review-ledger.mjs b/scripts/validate-independent-review-ledger.mjs
@@ -0,0 +1,110 @@
+import { createHash } from 'node:crypto';
+
+const DIMENSIONS = ['A','B','C','D','E','F','G','H'];
+const SEVERITIES = new Set(['P0','P1','P2','P3']);
+const DECISIONS = new Set(['rework','reject','hold','expert_reviewed','approved']);
+
+const isObject = (value) => value !== null && typeof value === 'object' && !Array.isArray(value);
+const nonEmpty = (value) => typeof value === 'string' && value.trim().length > 0;
+const canonical = (value) => Array.isArray(value) ? '[' + value.map(canonical).join(',') + ']' :
+  isObject(value) ? '{' + Object.keys(value).sort().map((key) => JSON.stringify(key) + ':' + canonical(value[key])).join(',') + '}' : JSON.stringify(value);
+const digest = (value) => 'sha256:' + createHash('sha256').update(canonical(value)).digest('hex');
+const hasAllScores = (scores) => isObject(scores) && DIMENSIONS.every((key) =>
+  Number.isInteger(scores[key]) && scores[key] >= 0 && scores[key] <= 4);
+
+export function validateIndependentReviewLedger(ledger) {
+  const errors = [];
+  const records = Array.isArray(ledger?.records) ? ledger.records : [];
+  const events = Array.isArray(ledger?.event_log) ? ledger.event_log : [];
+  if (ledger?.schema_version !== '1.0.0') errors.push('ledger schema_version must be 1.0.0');
+  if (ledger?.ledger_id !== 'maseer28-independent-content-review-ledger-v1') errors.push('ledger identity is invalid');
+  const blind = ledger?.blind_review_policy;
+  if (blind?.required_reviewers !== 2 || blind?.independent !== true ||
+      blind?.reviewer_ids_must_differ !== true ||
+      blind?.submissions_hidden_from_other_reviewer_until_both_submitted !== true ||
+      blind?.no_prepopulated_scores_or_reviewer_identity !== true) errors.push('blind independent review policy is weakened');
+  if (ledger?.governance?.release_score_threshold !== null ||
+      ledger?.governance?.disagreement_resolution !== 'third_qualified_adjudicator_required_no_averaging' ||
+      ledger?.governance?.runtime_requires !== 'approved_record_and_separate_versioned_runtime_grant') {
+    errors.push('review governance or fail-closed runtime policy is weakened');
+  }
+  const recordIds = new Set();
+  const eventIds = new Set();
+  for (const record of records) {
+    if (!isObject(record) || !nonEmpty(record.content_id) || recordIds.has(record.content_id)) {
+      errors.push('review record has missing or duplicate content_id'); continue;
+    }
+    recordIds.add(record.content_id);
+    if (!nonEmpty(record.content_version) || !nonEmpty(record.topic_id) ||
+        !Number.isInteger(record.day_number) || record.day_number < 1) errors.push('record identity/version fields are incomplete: ' + record.content_id);
+    const reviews = Array.isArray(record.reviews) ? record.reviews : [];
+    if (reviews.length > 2) errors.push('at most two first-line independent reviews are allowed: ' + record.content_id);
+    const reviewers = new Set();
+    for (const review of reviews) {
+      if (!nonEmpty(review.reviewer_id) || reviewers.has(review.reviewer_id)) errors.push('reviewer IDs must be present and distinct: ' + record.content_id);
+      reviewers.add(review.reviewer_id);
+      if (review.status !== 'submitted') errors.push('only submitted immutable reviews belong in the ledger: ' + record.content_id);
+      if (!hasAllScores(review.scores)) errors.push('submitted review must contain A-H scores from 0 to 4: ' + record.content_id);
+      if (!isObject(review.reviewer_qualification) || !nonEmpty(review.reviewer_qualification.credential_basis) ||
+          !nonEmpty(review.reviewer_qualification.scope) || !nonEmpty(review.reviewer_qualification.verified_by)) {
+        errors.push('reviewer qualification must be documented and independently verified: ' + record.content_id);
+      }
+      if (typeof review.conflict_of_interest?.declared !== 'boolean' ||
+          (review.conflict_of_interest.declared === true && !nonEmpty(review.conflict_of_interest.details))) {
+        errors.push('conflict-of-interest declaration is incomplete: ' + record.content_id);
+      }
+      if (!nonEmpty(review.submitted_at) || !Array.isArray(review.findings) ||
+          !Array.isArray(review.hard_stop_flags) || !Array.isArray(review.evidence_claim_reviews)) {
+        errors.push('review findings, evidence checks, safety flags and timestamp are required: ' + record.content_id);
+      }
+      for (const finding of review.findings ?? []) {
+        if (!SEVERITIES.has(finding.severity) || !nonEmpty(finding.finding_id) ||
+            !nonEmpty(finding.location) || !nonEmpty(finding.rationale) ||
+            typeof finding.resolved !== 'boolean') errors.push('finding schema invalid: ' + record.content_id);
+      }
+    }
+    const adjudication = record.adjudication;
+    const disagreement = reviews.length === 2 && DIMENSIONS.some((key) => reviews[0].scores?.[key] !== reviews[1].scores?.[key]);
+    if (record.decision === 'approved' || record.decision === 'expert_reviewed') {
+      if (reviews.length !== 2) errors.push('two submitted independent reviews are required before expert decision: ' + record.content_id);
+      if (disagreement && (!isObject(adjudication) || !nonEmpty(adjudication.adjudicator_id) ||
+          !nonEmpty(adjudication.qualification) || !nonEmpty(adjudication.rationale) ||
+          !nonEmpty(adjudication.decided_at))) errors.push('score disagreement requires qualified third-party adjudication: ' + record.content_id);
+      if (reviews.some((r) => r.hard_stop_flags.length > 0 ||
+          r.findings.some((f) => ['P0','P1'].includes(f.severity) && f.resolved !== true))) {
+        errors.push('open hard-stop/P0/P1 finding blocks expert decision: ' + record.content_id);
+      }
+      if (reviews.some((r) => DIMENSIONS.some((key) => r.scores[key] <= 1))) errors.push('score 0 or 1 blocks approval pending rework and review: ' + record.content_id);
+      if (!nonEmpty(record.decision_rationale) || !nonEmpty(record.decided_at)) errors.push('decision rationale and timestamp are required: ' + record.content_id);
+    }
+    if (!DECISIONS.has(record.decision)) errors.push('record decision is missing or invalid: ' + record.content_id);
+    if (record.runtime_eligible === true) {
+      const grant = record.runtime_grant;
+      if (record.decision !== 'approved' || !isObject(grant) ||
+          !nonEmpty(grant.grant_id) || !nonEmpty(grant.content_version) ||
+          grant.content_version !== record.content_version || !nonEmpty(grant.approved_by) ||
+          !nonEmpty(grant.issued_at) || !nonEmpty(grant.expires_at)) {
+        errors.push('runtime requires approved exact-version record and separate time-bounded grant: ' + record.content_id);
+      }
+    }
+  }
+  let previousId = null;
+  let previousHash = 'GENESIS';
+  events.forEach((event, index) => {
+    if (!nonEmpty(event.event_id) || eventIds.has(event.event_id)) errors.push('event IDs must be unique');
+    eventIds.add(event.event_id);
+    const { event_hash, ...hashableEvent } = event;
+    if (event.sequence !== index + 1 || event.previous_event_id !== previousId ||
+        event.previous_event_hash !== previousHash || !nonEmpty(event.event_type) ||
+        !nonEmpty(event.actor_id) || !nonEmpty(event.occurred_at) || !nonEmpty(event.payload_digest) ||
+        event_hash !== digest(hashableEvent)) errors.push('append-only hash chain is invalid at sequence ' + (index + 1));
+    previousId = event.event_id;
+    previousHash = event_hash ?? null;
+  });
+  return { valid: errors.length === 0, errors, summary: {
+    records: records.length, records_with_two_reviews: records.filter((r) => r.reviews?.length === 2).length,
+    approved_records: records.filter((r) => r.decision === 'approved').length,
+    runtime_eligible_records: records.filter((r) => r.runtime_eligible === true).length,
+    audit_events: events.length
+  }};
+}
diff --git a/scripts/validate-quality-safety-gates.mjs b/scripts/validate-quality-safety-gates.mjs
@@ -0,0 +1,145 @@
+import fs from 'node:fs';
+
+const REQUIRED_DIMENSIONS = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
+const REQUIRED_EVIDENCE_FIELDS = [
+  'population', 'construct_or_intervention', 'outcome',
+  'study_design_or_guideline_type', 'evidence_certainty',
+  'limitations', 'last_checked'
+];
+
+export function validateQualitySafetyGates({ policy, queue, pilot, evidence }) {
+  const errors = [];
+  const warnings = [];
+  const dimensions = policy?.review_dimensions ?? [];
+  const sources = Array.isArray(evidence?.sources) ? evidence.sources : [];
+  const sourceById = new Map(sources.map((source) => [source.evidence_id, source]));
+  const queueRecords = Array.isArray(queue?.records) ? queue.records : [];
+  const pilotRecords = Array.isArray(pilot?.records) ? pilot.records : [];
+
+  if (policy?.schema_version !== '1.0.0') errors.push('quality policy schema_version must be 1.0.0');
+  if (policy?.status !== 'proposed_pending_independent_review') errors.push('policy must remain pending independent review');
+  if (policy?.core_rule !== 'automated_validation_is_not_expert_or_clinical_approval') errors.push('missing non-equivalence rule');
+  if (dimensions.length !== 8 || !REQUIRED_DIMENSIONS.every((id) => dimensions.some((item) => item.id === id))) {
+    errors.push('policy must define all eight review dimensions A-H');
+  }
+  for (const dimension of dimensions) {
+    if (JSON.stringify(dimension.scale) !== JSON.stringify([0, 1, 2, 3, 4])) {
+      errors.push('invalid score scale for dimension ' + dimension.id);
+    }
+  }
+  if (policy?.scoring_policy?.reviewers_required !== 2 || policy?.scoring_policy?.independent_reviews !== true) {
+    errors.push('two independent reviewers are mandatory');
+  }
+  if (policy?.scoring_policy?.minimum_score_for_release !== null) {
+    errors.push('release threshold must remain unset pending calibration');
+  }
+  if (policy?.scoring_policy?.hard_stop_overrides_aggregate_score !== true) {
+    errors.push('hard-stop flags must override aggregate scores');
+  }
+  if (!Array.isArray(policy?.hard_stop_flags) || policy.hard_stop_flags.length < 1) {
+    errors.push('hard-stop flag registry is missing');
+  }
+  const severity = new Map((policy?.severity_levels ?? []).map((item) => [item.id, item]));
+  for (const id of ['P0', 'P1']) {
+    if (severity.get(id)?.release_block !== true) errors.push(id + ' must block release');
+  }
+  const runtime = policy?.runtime_policy;
+  if (JSON.stringify(runtime?.eligible_statuses) !== JSON.stringify(['approved']) ||
+      runtime?.require_separate_versioned_runtime_grant !== true ||
+      runtime?.fail_closed !== true ||
+      runtime?.expert_reviewed_is_not_release_approval !== true ||
+      runtime?.draft_pending_review_rework_required_rejected_retired_runtime_eligible !== false) {
+    errors.push('runtime policy must fail closed and require approved status plus a separate versioned grant');
+  }
+
+  if (queue?.total_records !== 952 || queueRecords.length !== 952) {
+    errors.push('redesign queue must contain exactly 952 records');
+  }
+  const queueIds = new Set();
+  const queueSlots = new Set();
+  for (const item of queueRecords) {
+    if (!item || typeof item !== 'object') { errors.push('queue record must be an object'); continue; }
+    if (!item.review_id || queueIds.has(item.review_id)) errors.push('missing or duplicate queue review_id');
+    queueIds.add(item.review_id);
+    const slot = item.topic_id + ':' + item.day_number;
+    if (queueSlots.has(slot)) errors.push('duplicate queue slot ' + slot);
+    queueSlots.add(slot);
+    if (item.review_status !== 'pending_review' || item.runtime_eligible !== false) {
+      errors.push('queue item must remain pending and runtime-blocked: ' + item.review_id);
+    }
+    if (!item.scores || Object.values(item.scores).some((score) => score !== null)) {
+      errors.push('unreviewed queue scores must all remain null: ' + item.review_id);
+    }
+  }
+
+  if (pilotRecords.length !== 25) errors.push('pilot must contain exactly 25 records');
+  const pilotIds = new Set();
+  const pilotSlots = new Set();
+  for (const item of pilotRecords) {
+    if (!item || typeof item !== 'object') { errors.push('pilot record must be an object'); continue; }
+    if (!item.content_id || pilotIds.has(item.content_id)) errors.push('missing or duplicate pilot content_id');
+    pilotIds.add(item.content_id);
+    const slot = item.topic_id + ':' + item.day_number;
+    if (pilotSlots.has(slot)) errors.push('duplicate pilot slot ' + slot);
+    pilotSlots.add(slot);
+    if (item.review_status !== 'draft_pending_expert_review' ||
+        item.runtime_eligible !== false ||
+        item.reviewer !== null ||
+        item.reviewed_at !== null) {
+      errors.push('pilot draft must remain unreviewed and runtime-blocked: ' + item.content_id);
+    }
+    const ids = Array.isArray(item.evidence_ids) ? item.evidence_ids : [];
+    const refs = Array.isArray(item.source_reference_ids) ? item.source_reference_ids : [];
+    if (!ids.length || [...ids].sort().join('|') !== [...refs].sort().join('|')) {
+      errors.push('evidence_ids and source_reference_ids must be non-empty and identical: ' + item.content_id);
+    }
+    for (const id of ids) {
+      const source = sourceById.get(id);
+      if (!source) {
+        errors.push('unknown evidence source ' + id + ' in ' + item.content_id);
+        continue;
+      }
+      for (const field of REQUIRED_EVIDENCE_FIELDS) {
+        if (source[field] === undefined || source[field] === null || source[field] === '') {
+          warnings.push('claim-level evidence metadata missing ' + field + ' for ' + id);
+        }
+      }
+    }
+    const queueMatches = queueRecords.filter((q) => q.topic_id === item.topic_id && q.day_number === item.day_number);
+    if (queueMatches.length !== 1 ||
+        queueMatches[0].draft_content_id !== item.content_id ||
+        queueMatches[0].source_content_id !== item.source_content_id) {
+      errors.push('pilot-to-queue mapping mismatch: ' + slot);
+    }
+  }
+
+  if (evidence?.registry_id !== 'maseer28-evidence-source-registry-v1' || !sources.length) {
+    errors.push('evidence registry identity or sources are missing');
+  }
+  return {
+    valid: errors.length === 0,
+    errors,
+    warnings: [...new Set(warnings)],
+    summary: {
+      policy_dimensions: dimensions.length,
+      hard_stop_flags: policy?.hard_stop_flags?.length ?? 0,
+      queue_records: queueRecords.length,
+      pilot_records: pilotRecords.length,
+      evidence_sources: sources.length,
+      runtime_eligible_pilot_records: pilotRecords.filter((item) => item?.runtime_eligible === true).length,
+      claim_metadata_warnings: new Set(warnings).size
+    }
+  };
+}
+
+if (process.argv[1]?.endsWith('validate-quality-safety-gates.mjs')) {
+  const read = (file) => JSON.parse(fs.readFileSync(file, 'utf8'));
+  const result = validateQualitySafetyGates({
+    policy: read('public/assistant/quality/content-quality-safety-gates.v1.json'),
+    queue: read('public/assistant/content-drafts/952-day-redesign-queue.v1.json'),
+    pilot: read('public/assistant/content-drafts/day04-08-self-evaluation-cluster-pilot.v1.json'),
+    evidence: read('public/assistant/evidence/evidence-source-registry.v1.json')
+  });
+  console.log(JSON.stringify(result, null, 2));
+  if (!result.valid) throw new Error('Quality and safety gate validation failed');
+}
diff --git a/tests/independent-review-ledger.test.mjs b/tests/independent-review-ledger.test.mjs
@@ -0,0 +1,20 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { validateIndependentReviewLedger } from '../scripts/validate-independent-review-ledger.mjs';
+
+const base = {
+ schema_version:'1.0.0', ledger_id:'maseer28-independent-content-review-ledger-v1',
+ blind_review_policy:{required_reviewers:2,independent:true,reviewer_ids_must_differ:true,submissions_hidden_from_other_reviewer_until_both_submitted:true,no_prepopulated_scores_or_reviewer_identity:true},
+ governance:{release_score_threshold:null,disagreement_resolution:'third_qualified_adjudicator_required_no_averaging',runtime_requires:'approved_record_and_separate_versioned_runtime_grant'},
+ records:[],event_log:[]
+};
+const mkReview=(id,score=3)=>({reviewer_id:id,status:'submitted',scores:Object.fromEntries('ABCDEFGH'.split('').map(k=>[k,score])),reviewer_qualification:{credential_basis:'verified professional qualification',scope:'relevant content domain',verified_by:'independent verifier'},conflict_of_interest:{declared:false},submitted_at:'2026-11-02T10:00:00Z',findings:[],hard_stop_flags:[],evidence_claim_reviews:[]});
+const mkRecord=(reviews,extra={})=>({content_id:'DRAFT_T15_D04',content_version:'1.0.0',topic_id:'T15',day_number:4,reviews,decision:'hold',runtime_eligible:false,...extra});
+
+test('empty template is valid and contains no fabricated reviews',()=>{const r=validateIndependentReviewLedger(base);assert.equal(r.valid,true,r.errors.join('\n'));assert.equal(r.summary.records,0);});
+test('one reviewer cannot advance a record to expert decision',()=>{const l=structuredClone(base);l.records=[mkRecord([mkReview('reviewer-a')],{decision:'expert_reviewed'})];const r=validateIndependentReviewLedger(l);assert.ok(r.errors.some(x=>x.includes('two submitted independent reviews')));});
+test('same reviewer cannot submit two independent reviews',()=>{const l=structuredClone(base);l.records=[mkRecord([mkReview('reviewer-a'),mkReview('reviewer-a')])];const r=validateIndependentReviewLedger(l);assert.ok(r.errors.some(x=>x.includes('distinct')));});
+test('disagreement requires third-party adjudication and cannot be averaged',()=>{const l=structuredClone(base);l.records=[mkRecord([mkReview('reviewer-a',2),mkReview('reviewer-b',3)],{decision:'approved',decision_rationale:'approved',decided_at:'2026-11-02T12:00:00Z'})];const r=validateIndependentReviewLedger(l);assert.ok(r.errors.some(x=>x.includes('third-party adjudication')));});
+test('open P1 or hard stop blocks approval',()=>{const l=structuredClone(base);const a=mkReview('reviewer-a'),b=mkReview('reviewer-b');a.findings=[{finding_id:'F1',severity:'P1',location:'exercise',rationale:'risk',resolved:false}];l.records=[mkRecord([a,b],{decision:'approved',decision_rationale:'approved',decided_at:'2026-11-02T12:00:00Z'})];const r=validateIndependentReviewLedger(l);assert.ok(r.errors.some(x=>x.includes('blocks expert decision')));});
+test('runtime cannot be enabled without a separate exact-version grant',()=>{const l=structuredClone(base);l.records=[mkRecord([mkReview('reviewer-a'),mkReview('reviewer-b')],{decision:'approved',decision_rationale:'approved',decided_at:'2026-11-02T12:00:00Z',runtime_eligible:true})];const r=validateIndependentReviewLedger(l);assert.ok(r.errors.some(x=>x.includes('separate time-bounded grant')));});

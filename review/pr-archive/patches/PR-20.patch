diff --git a/scripts/audit-content-mappings.mjs b/scripts/audit-content-mappings.mjs
@@ -0,0 +1,142 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const readJson = (relativePath) => JSON.parse(fs.readFileSync(path.join(root, relativePath), 'utf8'));
+const normalize = (value) => String(value ?? '').normalize('NFKC').replace(/\s+/g, ' ').trim();
+
+export function auditContentMappings({ content, topics, subtopics, evidenceRegistry, mappingSet }) {
+  const errors = [];
+  const topicList = topics.topics ?? [];
+  const subtopicList = subtopics.subtopics ?? [];
+  const categoryEntries = Object.entries(content.categories ?? {});
+  if (topicList.length !== 34) errors.push(`Expected 34 topics, found ${topicList.length}.`);
+  if (subtopicList.length !== 102) errors.push(`Expected 102 subtopics, found ${subtopicList.length}.`);
+  if (categoryEntries.length !== 34) errors.push(`Expected 34 content categories, found ${categoryEntries.length}.`);
+  const topicByName = new Map();
+  const topicIds = new Set();
+  for (const item of topicList) {
+    const name = normalize(item.name);
+    if (!name || topicByName.has(name)) errors.push(`Missing or duplicate normalized topic name: ${name}`);
+    if (!item.topic_id || topicIds.has(item.topic_id)) errors.push(`Missing or duplicate topic ID: ${item.topic_id}`);
+    topicByName.set(name, item);
+    topicIds.add(item.topic_id);
+  }
+  const subtopicById = new Map();
+  for (const item of subtopicList) {
+    if (!item.subtopic_id || subtopicById.has(item.subtopic_id)) errors.push(`Missing or duplicate subtopic ID: ${item.subtopic_id}`);
+    subtopicById.set(item.subtopic_id, item);
+  }
+  const evidenceById = new Map();
+  for (const item of evidenceRegistry?.evidence ?? []) {
+    if (!item.evidence_id || evidenceById.has(item.evidence_id)) errors.push(`Missing or duplicate evidence ID: ${item.evidence_id}`);
+    evidenceById.set(item.evidence_id, item);
+  }
+  const expected = new Map();
+  const sourceContentIds = new Set();
+
+  for (const [topicName, category] of Object.entries(content.categories ?? {})) {
+    const topic = topicByName.get(normalize(topicName));
+    if (!topic) {
+      errors.push(`No exact topic match for content category: ${topicName}`);
+      continue;
+    }
+    if (!Array.isArray(category.days) || category.days.length !== 28) errors.push(`Expected 28 days for category: ${topicName}`);
+    for (const [index, day] of (category.days ?? []).entries()) {
+      if (!day.id) errors.push(`Missing source content ID for ${topicName}, day ${index + 1}`);
+      if (sourceContentIds.has(day.id)) errors.push(`Duplicate source content ID: ${day.id}`);
+      sourceContentIds.add(day.id);
+      const mappingId = `MAP_${topic.topic_id}_D${String(index + 1).padStart(2, '0')}`;
+      expected.set(mappingId, { topic, topicName, dayNumber: index + 1, contentId: day.id });
+    }
+  }
+
+  if (!Array.isArray(mappingSet?.mappings)) errors.push('Mapping set must contain a mappings array.');
+  if (!['draft_review_queue_only','under_review','reviewed_not_runtime_approved'].includes(mappingSet?.status)) errors.push('Mapping set status is invalid or too permissive.');
+  if (!['draft_requires_expert_review','under_review','reviewed_not_runtime_approved'].includes(evidenceRegistry?.status)) errors.push('Evidence registry status is invalid or too permissive.');
+  const seen = new Set();
+  const counts = { pending_review: 0, in_review: 0, approved: 0, rejected: 0 };
+  for (const mapping of mappingSet.mappings ?? []) {
+    const expectedRecord = expected.get(mapping.mapping_id);
+    if (seen.has(mapping.mapping_id)) errors.push(`Duplicate mapping id: ${mapping.mapping_id}`);
+    seen.add(mapping.mapping_id);
+    if (!expectedRecord) {
+      errors.push(`Unknown mapping id: ${mapping.mapping_id}`);
+      continue;
+    }
+    if (mapping.source_topic_id !== expectedRecord.topic.topic_id ||
+        mapping.source_topic_name !== expectedRecord.topicName ||
+        Number(mapping.day_number) !== expectedRecord.dayNumber ||
+        mapping.content_id !== expectedRecord.contentId) {
+      errors.push(`Source identity mismatch: ${mapping.mapping_id}`);
+    }
+    if (!Object.hasOwn(counts, mapping.mapping_status)) {
+      errors.push(`Invalid mapping status: ${mapping.mapping_id}`);
+      continue;
+    }
+    counts[mapping.mapping_status] += 1;
+
+    if (!Array.isArray(mapping.subtopic_ids) || new Set(mapping.subtopic_ids).size !== mapping.subtopic_ids.length) errors.push(`Subtopic IDs must be a unique array: ${mapping.mapping_id}`);
+    for (const subtopicId of mapping.subtopic_ids ?? []) {
+      const subtopic = subtopicById.get(subtopicId);
+      if (!subtopic) errors.push(`Unknown subtopic ${subtopicId}: ${mapping.mapping_id}`);
+      else if (subtopic.topic_id !== mapping.source_topic_id) {
+        errors.push(`Subtopic belongs to another parent topic: ${mapping.mapping_id} -> ${subtopicId}`);
+      }
+    }
+
+    if (mapping.mapping_status === 'approved') {
+      const review = mapping.review ?? {};
+      if (!(mapping.subtopic_ids ?? []).length) errors.push(`Approved mapping has no subtopic: ${mapping.mapping_id}`);
+      if (!String(review.reviewer_id ?? '').trim()) errors.push(`Approved mapping lacks reviewer: ${mapping.mapping_id}`);
+      if (!review.reviewed_at || Number.isNaN(Date.parse(review.reviewed_at))) errors.push(`Approved mapping lacks valid review date: ${mapping.mapping_id}`);
+      if (!String(review.rationale ?? '').trim()) errors.push(`Approved mapping lacks rationale: ${mapping.mapping_id}`);
+      if (!Array.isArray(review.evidence_ids) || !review.evidence_ids.length) errors.push(`Approved mapping lacks evidence IDs: ${mapping.mapping_id}`);
+      if (new Set(review.evidence_ids ?? []).size !== (review.evidence_ids ?? []).length) errors.push(`Approved mapping evidence IDs must be unique: ${mapping.mapping_id}`);
+      for (const evidenceId of review.evidence_ids ?? []) {
+        const evidence = evidenceById.get(evidenceId);
+        if (!evidence) errors.push(`Approved mapping references unknown evidence ${evidenceId}: ${mapping.mapping_id}`);
+        else if (evidence.review_status !== 'approved' || !evidence.reviewer_id?.trim() || !evidence.reviewed_at || Number.isNaN(Date.parse(evidence.reviewed_at)) || !evidence.title?.trim() || !evidence.citation?.trim() || !evidence.population?.trim() || !evidence.study_type?.trim()) {
+          errors.push(`Approved mapping references unapproved or untraceable evidence ${evidenceId}: ${mapping.mapping_id}`);
+        }
+      }
+    } else if (mapping.mapping_status === 'rejected' && !String(mapping.review?.rationale ?? '').trim()) {
+      errors.push(`Rejected mapping lacks rationale: ${mapping.mapping_id}`);
+    }
+  }
+
+  const missing = [...expected.keys()].filter((id) => !seen.has(id));
+  if (mappingSet.runtime_eligible !== false) errors.push('Mapping set must remain runtime_eligible=false.');
+  if (evidenceRegistry?.runtime_eligible !== false) errors.push('Evidence registry must remain runtime_eligible=false.');
+  return {
+    errors,
+    counts: {
+      expected_source_days: expected.size,
+      mapping_records: seen.size,
+      missing_records: missing.length,
+      ...counts,
+      approved_evidence_records: [...evidenceById.values()].filter((item) => item.review_status === 'approved').length,
+    },
+    readiness: {
+      structural_integrity: errors.length === 0,
+      complete_source_coverage: missing.length === 0,
+      all_records_reviewed: missing.length === 0 && counts.pending_review === 0 && counts.in_review === 0,
+      evidence_registry_ready: evidenceById.size > 0 && [...evidenceById.values()].every((item) => item.review_status === 'approved'),
+      approved_for_runtime: false,
+    },
+    missing_mapping_ids: missing,
+  };
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const report = auditContentMappings({
+    content: readJson('public/content/path-content.json'),
+    topics: readJson('public/assistant/knowledge/topics.v1.json'),
+    subtopics: readJson('public/assistant/knowledge/subtopics.v1.json'),
+    evidenceRegistry: readJson('public/assistant/evidence/evidence.v1.json'),
+    mappingSet: readJson('public/assistant/mappings/course-content-mappings.v1.json'),
+  });
+  process.stdout.write(`${JSON.stringify(report, null, 2)}\n`);
+  if (report.errors.length) process.exitCode = 1;
+}
diff --git a/scripts/audit-course-content-quality.mjs b/scripts/audit-course-content-quality.mjs
@@ -0,0 +1,153 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const readJson = (p) => JSON.parse(fs.readFileSync(path.join(root, p), 'utf8'));
+const DIMENSIONS = ['target_specificity','psychological_mechanism','evidence_support','exercise_alignment','progression_and_difficulty','safety_and_cautions','outcome_measurement','accessibility'];
+const TEXT_FIELDS = ['title','intro','exercise','actionText','closing'];
+const isTextBoundary = (character) => !character || /[\s،؛,.!?()[\]{}«»]/u.test(character);
+function replaceTopicToken(text, topic) {
+  let cursor = 0;
+  let result = '';
+  let index = text.indexOf(topic, cursor);
+  while (index !== -1) {
+    const before = index === 0 ? '' : text[index - 1];
+    const afterIndex = index + topic.length;
+    const after = afterIndex >= text.length ? '' : text[afterIndex];
+    result += text.slice(cursor, index);
+    result += isTextBoundary(before) && isTextBoundary(after) ? '[TOPIC]' : topic;
+    cursor = afterIndex;
+    index = text.indexOf(topic, cursor);
+  }
+  return result + text.slice(cursor);
+}
+export const normalizeTemplateText = (value, topic) => {
+  const text = String(value ?? '').normalize('NFKC');
+  const normalizedTopic = String(topic ?? '').normalize('NFKC').trim();
+  if (!normalizedTopic) return text.replace(/\s+/g, ' ').trim().toLocaleLowerCase('fa');
+  const quoted = text.split('«' + normalizedTopic + '»').join('«[TOPIC]»');
+  return replaceTopicToken(quoted, normalizedTopic).replace(/\s+/g, ' ').trim().toLocaleLowerCase('fa');
+};
+const normalize = normalizeTemplateText;
+
+
+export function buildReviewQueue(content, topics) {
+  const topicList = topics.topics ?? [];
+  const categoryEntries = Object.entries(content.categories ?? {});
+  if (topicList.length !== 34) throw new Error(`Expected 34 topic definitions, found ${topicList.length}`);
+  if (categoryEntries.length !== 34) throw new Error(`Expected 34 content categories, found ${categoryEntries.length}`);
+  const topicIds = new Set();
+  const topicNames = new Set();
+  for (const topic of topicList) {
+    const id = String(topic.topic_id ?? '');
+    const name = String(topic.name ?? '').normalize('NFKC').trim();
+    if (!id || topicIds.has(id)) throw new Error(`Missing or duplicate topic ID: ${id}`);
+    if (!name || topicNames.has(name)) throw new Error(`Missing or duplicate topic name: ${name}`);
+    topicIds.add(id);
+    topicNames.add(name);
+  }
+  const byName = new Map(topicList.map((t) => [String(t.name).normalize('NFKC').trim(), t]));
+  const seenContentIds = new Set();
+  const reviews = [];
+  for (const [name, category] of Object.entries(content.categories ?? {})) {
+    const topic = byName.get(String(name).normalize('NFKC').trim());
+    if (!topic) throw new Error(`No exact topic registry match: ${name}`);
+    if (!Array.isArray(category.days) || category.days.length !== 28) throw new Error(`Expected 28 days: ${name}`);
+    category.days.forEach((day,index) => {
+      if (!day.id) throw new Error(`Missing content ID for ${topic.topic_id}, day ${index+1}`);
+      if (seenContentIds.has(day.id)) throw new Error(`Duplicate source content ID: ${day.id}`);
+      seenContentIds.add(day.id);
+      reviews.push({
+        review_id:`QREV_${topic.topic_id}_D${String(index+1).padStart(2,'0')}`,
+        topic_id:topic.topic_id, day_number:index+1, content_id:day.id,
+        review_status:'pending_review',
+        scores:Object.fromEntries(DIMENSIONS.map((d)=>[d,null])),
+        reviewer_id:null, reviewed_at:null, rationale:null, evidence_ids:[], safety_notes:[]
+      });
+    });
+  }
+  return reviews;
+}
+
+export function auditCourseContentQuality({content,topics,ledger,evidenceRegistry}) {
+  const errors=[];
+  const expected=buildReviewQueue(content,topics);
+  const expectedById=new Map(expected.map(item=>[item.review_id,item]));
+  const sourceById=new Map();
+  for(const [name,category] of Object.entries(content.categories ?? {})){
+    const topic=topics.topics.find(t=>t.name===name);
+    for(const [i,day] of (category.days ?? []).entries()) sourceById.set(`QREV_${topic?.topic_id}_D${String(i+1).padStart(2,'0')}`,{day});
+  }
+  if (evidenceRegistry?.runtime_eligible !== false) errors.push('Evidence registry must remain runtime_eligible=false.');
+  const evidenceById=new Map();
+  for (const item of evidenceRegistry?.evidence ?? []) {
+    if (evidenceById.has(item.evidence_id)) errors.push('Duplicate evidence ID: '+item.evidence_id);
+    evidenceById.set(item.evidence_id,item);
+  }
+  const seen=new Set(), statusCounts={pending_review:0,in_review:0,needs_revision:0,rejected:0,reviewed_not_approved:0,approved_for_educational_review:0};
+  const repeated={};
+  for(const field of TEXT_FIELDS){
+    const perDay=[];
+    for(let day=0;day<28;day++){
+      const groups=new Map();
+      for(const [topic,category] of Object.entries(content.categories ?? {})){
+        const value=normalize(category.days?.[day]?.[field],topic);
+        if(value) groups.set(value,[...(groups.get(value)??[]),topic]);
+      }
+      perDay.push({day:day+1,shared_templates:[...groups.values()].filter(v=>v.length>1).map(names=>({topic_count:names.length,topics:names}))});
+    }
+    repeated[field]=perDay;
+  }
+  for(const review of ledger.reviews ?? []){
+    if(seen.has(review.review_id)) errors.push(`Duplicate review id: ${review.review_id}`);
+    seen.add(review.review_id);
+    const source=sourceById.get(review.review_id);
+    if(!source) {errors.push(`Unknown review id: ${review.review_id}`);continue;}
+    if(review.content_id!==source.day.id) errors.push(`Source content ID mismatch: ${review.review_id}`);
+    if(review.topic_id!==expectedById.get(review.review_id)?.topic_id) errors.push(`Topic ID mismatch: ${review.review_id}`);
+    if(!Object.hasOwn(statusCounts,review.review_status)){errors.push(`Invalid status: ${review.review_id}`);continue;}
+    statusCounts[review.review_status]++;
+    const scoreKeys = Object.keys(review.scores ?? {}).sort();
+    if (scoreKeys.join('|') !== [...DIMENSIONS].sort().join('|')) errors.push(`Score dimensions mismatch: ${review.review_id}`);
+    if (!Array.isArray(review.evidence_ids) || new Set(review.evidence_ids).size !== review.evidence_ids.length) errors.push(`Evidence IDs must be a unique array: ${review.review_id}`);
+    for(const dimension of DIMENSIONS){
+      const score=review.scores?.[dimension];
+      if(score!==null && (!Number.isInteger(score)||score<0||score>3)) errors.push(`Invalid score ${dimension}: ${review.review_id}`);
+    }
+    for(const evidenceId of review.evidence_ids ?? []) {
+      const evidence=evidenceById.get(evidenceId);
+      if(!evidence) errors.push('Unknown evidence ID (not present in evidence registry): '+review.review_id+' -> '+evidenceId);
+      else if(!evidence.title?.trim() || !evidence.citation?.trim()) errors.push('Evidence source is not traceable: '+review.review_id+' -> '+evidenceId);
+    }
+    if(review.review_status==='approved_for_educational_review'){
+      if(DIMENSIONS.some(d=>!Number.isInteger(review.scores?.[d])||review.scores[d]<2)) errors.push(`Approval requires all eight scores >=2: ${review.review_id}`);
+      if((review.scores?.safety_and_cautions??0)<2) errors.push(`Approval blocked by safety score: ${review.review_id}`);
+      if(!review.reviewer_id?.trim()) errors.push(`Approval lacks reviewer: ${review.review_id}`);
+      if(!review.reviewed_at||Number.isNaN(Date.parse(review.reviewed_at))) errors.push(`Approval lacks review date: ${review.review_id}`);
+      if(!review.rationale?.trim()) errors.push(`Approval lacks rationale: ${review.review_id}`);
+      if(!(review.evidence_ids?.length)) errors.push(`Approval lacks evidence IDs: ${review.review_id}`);
+      for(const evidenceId of review.evidence_ids ?? []) {
+        const evidence=evidenceById.get(evidenceId);
+        if(!evidence || !['reviewed','approved'].includes(evidence.review_status) || !evidence.reviewer_id?.trim() || !evidence.reviewed_at || !evidence.citation?.trim()) errors.push('Approval cites evidence that is absent, unreviewed, or untraceable: '+review.review_id+' -> '+evidenceId);
+      }
+    }
+  }
+  const missing=expected.filter(x=>!seen.has(x.review_id)).map(x=>x.review_id);
+  if(ledger.runtime_eligible!==false) errors.push('Quality review ledger must remain runtime_eligible=false.');
+  return {
+    errors,
+    coverage:{expected_days:expected.length,review_records:seen.size,missing_reviews:missing.length,...statusCounts},
+    text_template_warnings:Object.fromEntries(Object.entries(repeated).map(([field,days])=>[field,days.filter(d=>d.shared_templates.length>0).length])),
+    repeated_templates_by_field:repeated,
+    readiness:{structural_integrity:errors.length===0,complete_review_coverage:missing.length===0,all_reviewed:missing.length===0&&statusCounts.pending_review===0&&statusCounts.in_review===0,approved_for_educational_review:errors.length===0&&missing.length===0&&statusCounts.approved_for_educational_review===expected.length,runtime_eligible:false},
+    missing_review_ids:missing,
+    limitations:['این ابزار معنای بالینی یا تناسب واقعی تمرین را ارزیابی نمی‌کند.','تفاوت متنی به‌تنهایی اختصاصی‌بودن آموزشی را ثابت نمی‌کند.','تأیید آموزشی معادل اثربخشی درمانی یا مجوز توصیه خودکار نیست.']
+  };
+}
+
+if(process.argv[1]&&path.resolve(process.argv[1])===fileURLToPath(import.meta.url)){
+ const report=auditCourseContentQuality({content:readJson('public/content/path-content.json'),topics:readJson('public/assistant/knowledge/topics.v1.json'),ledger:readJson('public/assistant/reviews/course-content-quality-review.v1.json'),evidenceRegistry:readJson('public/assistant/evidence/evidence.v1.json')});
+ process.stdout.write(`${JSON.stringify(report,null,2)}\n`);
+ if(report.errors.length) process.exitCode=1;
+}
diff --git a/scripts/generate-content-mapping-queue.mjs b/scripts/generate-content-mapping-queue.mjs
@@ -0,0 +1,67 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const readJson = (relativePath) => JSON.parse(fs.readFileSync(path.join(root, relativePath), 'utf8'));
+const normalize = (value) => String(value ?? '').normalize('NFKC').replace(/\s+/g, ' ').trim();
+
+export function buildContentMappingQueue({ content, topics, existing = null }) {
+  const topicByName = new Map((topics.topics ?? []).map((topic) => [normalize(topic.name), topic]));
+  const oldMappings = new Map((existing?.mappings ?? []).map((item) => [item.mapping_id, item]));
+  const mappings = [];
+
+  for (const [topicName, category] of Object.entries(content.categories ?? {})) {
+    const topic = topicByName.get(normalize(topicName));
+    if (!topic) throw new Error(`No exact topic registry match for content category: ${topicName}`);
+    if (!Array.isArray(category.days) || category.days.length !== 28) {
+      throw new Error(`Expected exactly 28 days for category: ${topicName}`);
+    }
+
+    category.days.forEach((day, index) => {
+      const dayNumber = index + 1;
+      const mappingId = `MAP_${topic.topic_id}_D${String(dayNumber).padStart(2, '0')}`;
+      if (!day.id) throw new Error(`Missing content day id: ${mappingId}`);
+      const previous = oldMappings.get(mappingId);
+      if (previous && previous.content_id !== day.id) {
+        throw new Error(`Source content changed for ${mappingId}; manual reconciliation required.`);
+      }
+      mappings.push(previous ?? {
+        mapping_id: mappingId,
+        source_topic_id: topic.topic_id,
+        source_topic_name: topicName,
+        day_number: dayNumber,
+        content_id: day.id,
+        subtopic_ids: [],
+        mapping_status: 'pending_review',
+        review: { reviewer_id: null, reviewed_at: null, rationale: null, evidence_ids: [] },
+        notes: [],
+      });
+    });
+  }
+
+  if (oldMappings.size > mappings.length) throw new Error('Existing mapping ledger contains records not present in the current course registry.');
+  return {
+    schema_version: '1.0.0',
+    mapping_set_id: 'maseer28-course-content-mappings-v1',
+    status: 'draft_review_queue_only',
+    runtime_eligible: false,
+    source: {
+      content_registry: 'public/content/path-content.json',
+      topic_registry: 'public/assistant/knowledge/topics.v1.json',
+      subtopic_registry: 'public/assistant/knowledge/subtopics.v1.json',
+    },
+    policy: 'Parent topic is assigned only by exact category-name match. Subtopic assignments require human review.',
+    mappings,
+  };
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const outputPath = path.join(root, 'public/assistant/mappings/course-content-mappings.v1.json');
+  const content = readJson('public/content/path-content.json');
+  const topics = readJson('public/assistant/knowledge/topics.v1.json');
+  const existing = fs.existsSync(outputPath) ? readJson('public/assistant/mappings/course-content-mappings.v1.json') : null;
+  const queue = buildContentMappingQueue({ content, topics, existing });
+  fs.writeFileSync(outputPath, `${JSON.stringify(queue, null, 2)}\n`);
+  process.stdout.write(`Generated ${queue.mappings.length} review records; subtopic assignments remain empty and runtime_eligible=false.\n`);
+}
diff --git a/tests/contentMappingAudit.test.js b/tests/contentMappingAudit.test.js

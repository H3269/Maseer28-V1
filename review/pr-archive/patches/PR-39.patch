+const KNOWN_TOPIC = /^T(0[1-9]|[12][0-9]|3[0-4])$/;
+const MAX_RESULTS = 5;
+const STOP_WORDS = new Set(['چیست', 'چه', 'چگونه', 'درباره', 'در', 'از', 'به', 'برای', 'من', 'تو', 'این', 'آن', 'یک', 'و', 'یا', 'را', 'می', 'شود', 'است', 'هست', 'دارم', 'دارید', 'آیا', 'کنم', 'کنید']);

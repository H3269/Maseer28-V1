name: Fast focused UI regression

on:
  pull_request:
    branches: [main]
    paths:
      - "src/features/journey/JourneyScreens.jsx"
      - "src/features/assistant/GlobalAssistantLauncher.jsx"
      - "src/styles/original-v72.css"
      - "src/styles/iranian-turquoise-preview.css"
      - "tests/actionButtonVisualConsistency.test.mjs"
      - "tests/assistantFirstUseGuide.test.mjs"
      - "tests/supportIconsFeedbackScoreColor.test.mjs"
      - ".github/workflows/action-button-ui.yml"
      - ".github/workflows/deploy.yml"
      - "tests/browser/feedback-score-bubble.mjs"
      - "tests/browser/reader-open-recommendation.mjs"
      - "tests/pathDurationValidation.test.mjs"

permissions:
  contents: read

jobs:
  action-button-ui:
    runs-on: ubuntu-latest
    timeout-minutes: 8
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - name: Install dependencies
        run: npm ci
      - name: Run focused UI consistency checks
        run: node --test tests/actionButtonVisualConsistency.test.mjs tests/assistantFirstUseGuide.test.mjs tests/supportIconsFeedbackScoreColor.test.mjs tests/pathDurationValidation.test.mjs
      - name: Verify focused browser test scripts parse
        run: node --check tests/browser/feedback-score-bubble.mjs && node --check tests/browser/reader-open-recommendation.mjs
      - name: Verify production bundle
        run: npm run build
